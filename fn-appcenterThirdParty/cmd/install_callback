#!/bin/bash

echo "第三方应用中心安装回调..."

chmod +x ${TRIM_APPDEST}/app/ui/*.cgi 2>/dev/null || true
chmod +x ${TRIM_APPDEST}/app/www/*.cgi 2>/dev/null || true
chmod +x ${TRIM_APPDEST}/app/server/* 2>/dev/null || true

mkdir -p "${TRIM_PKGVAR}"
mkdir -p "${TRIM_PKGVAR}/cache"

# Create AppStore directory in user's file space for easy access
# Try to find the user's file space directory (typically under /vol1 or similar)
USER_FILES_DIR="/vol1/我的文件"
if [ -d "$USER_FILES_DIR" ]; then
    APPSTORE_DIR="$USER_FILES_DIR/AppStore"
    mkdir -p "$APPSTORE_DIR"
    chmod 755 "$APPSTORE_DIR"
    echo "Created AppStore directory for user uploads: $APPSTORE_DIR"
else
    # Try alternative locations
    for vol in /vol*; do
        if [ -d "$vol" ]; then
            USER_FILES_DIR="$vol/我的文件"
            if [ -d "$USER_FILES_DIR" ]; then
                APPSTORE_DIR="$USER_FILES_DIR/AppStore"
                mkdir -p "$APPSTORE_DIR"
                chmod 755 "$APPSTORE_DIR"
                echo "Created AppStore directory for user uploads: $APPSTORE_DIR"
                break
            fi
        fi
    done
fi

# Initialize sources.json if it doesn't exist
SOURCES_FILE="${TRIM_PKGVAR}/sources.json"
if [ ! -f "${SOURCES_FILE}" ]; then
    TS=$(date +%s)
    
    # 尝试从远程列表获取源信息 (注意将 blob 替换为 raw 获取纯文本)
    REMOTE_LIST_URL="https://gitee.com/laoknas/fn_fpk_packages/raw/master/AppStoreList.txt"
    RAW_LIST=$(curl -s -L --connect-timeout 10 "${REMOTE_LIST_URL}" | tr -d '\r' | grep -v '^$' || true)
    
    if [ -n "$RAW_LIST" ] && echo "$RAW_LIST" | grep -q ",http"; then
        JSON_ARRAY="["
        INDEX=1
        while IFS=',' read -r NAME URL; do
            if [ -n "$NAME" ] && [ -n "$URL" ]; then
                ID="source_$((TS + INDEX))"
                ENABLED="false"
                # 默认启用第一个源
                [ $INDEX -eq 1 ] && ENABLED="true"
                
                [ $INDEX -gt 1 ] && JSON_ARRAY="${JSON_ARRAY},"
                
                JSON_ARRAY="${JSON_ARRAY}
  {
    \"id\": \"${ID}\",
    \"name\": \"${NAME}(预设)\",
    \"url\": \"${URL}\",
    \"enabled\": ${ENABLED},
    \"auto_update\": true,
    \"last_sync\": \"\",
    \"app_count\": 0,
    \"local\": false,
    \"last_checked\": 0
  }"
                INDEX=$((INDEX + 1))
            fi
        done <<< "$RAW_LIST"
        JSON_ARRAY="${JSON_ARRAY}
]"
        echo "$JSON_ARRAY" > "${SOURCES_FILE}"
        echo "Default sources config created with preset sources: ${SOURCES_FILE}"
    else
        echo "Failed to fetch remote source list or list is empty. Skipping preset sources initialization."
    fi
fi

echo "安装回调完成！"
exit 0
