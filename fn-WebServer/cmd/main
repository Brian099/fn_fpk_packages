#!/bin/bash

# 获取程序所在的安装目录和数据目录
APP_DIR="${TRIM_APPDEST:-/var/apps/WebServer/target}"
DATA_DIR="${TRIM_PKGVAR:-/var/apps/WebServer/var}"

LOG_FILE="${DATA_DIR}/info.log"
PID_FILE="${DATA_DIR}/reverseproxy.pid"
STATE_FILE="${DATA_DIR}/.running"
SOCKET_FILE="${DATA_DIR}/reverseproxy.sock"
BINARY="${APP_DIR}/server/reverseproxy"
WWW_DIR="${APP_DIR}/www"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >>${LOG_FILE}
}

status() {
  # 检查 .running 指示文件
  if [ ! -f "${STATE_FILE}" ]; then
    return 1
  fi
  
  # 检查二进制进程是否在运行
  if [ -f "${PID_FILE}" ]; then
    local pid=$(cat "${PID_FILE}")
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  fi
  return 1
}

start_process() {
  if status; then
    log_msg "Processes already running"
    return 0
  fi

  log_msg "========== STARTING WEB SERVER COMPONENTS =========="
  
  # 确保目录存在
  mkdir -p "${DATA_DIR}"
  
  # 1. 启动反向代理后端 (Go)
  if [ -f "${BINARY}" ]; then
    chmod +x "${BINARY}"
    log_msg "Starting Reverse Proxy backend..."
    "${BINARY}" -cd "${DATA_DIR}" -www "${WWW_DIR}" -unix-socket "${SOCKET_FILE}" >>"${LOG_FILE}" 2>&1 &
    echo $! > "${PID_FILE}"
    sleep 1
  else
    log_msg "ERROR: Reverse Proxy binary not found at ${BINARY}"
  fi

  # 创建运行标记文件
  touch "${STATE_FILE}"
  log_msg "All components started"
  return 0
}

stop_process() {
  log_msg "========== STOPPING WEB SERVER COMPONENTS =========="
  
  # 1. 停止反向代理后端
  if [ -f "${PID_FILE}" ]; then
    local pid=$(cat "${PID_FILE}")
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      log_msg "Stopping Reverse Proxy (PID $pid)..."
      kill "$pid" 2>/dev/null
      sleep 1
      kill -9 "$pid" 2>/dev/null
    fi
    rm -f "${PID_FILE}"
  fi
  
  # 清理 Socket 文件
  rm -f "${SOCKET_FILE}"

  # 移除运行标记文件
  rm -f "${STATE_FILE}"
  log_msg "All components stopped"
  return 0
}

case $1 in
  start)
    start_process
    exit 0
    ;;
  stop)
    stop_process
    exit 0
    ;;
  status)
    if status; then
      echo "Running"
      exit 0
    else
      echo "Not running"
      exit 3
    fi
    ;;
  restart)
    stop_process
    sleep 1
    start_process
    exit 0
    ;;
  *)
    echo "Usage: $0 {start|stop|status|restart}"
    exit 1
    ;;
esac
