#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TRIM_PKGVAR="${TRIM_PKGVAR:-${APP_ROOT}/var}"
CONF_FILE="${TRIM_PKGVAR}/config.yaml"

echo ">>> fnosnassign 安装回调开始..."

# 1. 确保必要的目录存在
mkdir -p "${TRIM_PKGVAR}"


# 3. 权限修正
# 确保运行用户对数据目录有完全控制权
chmod -R 755 "${TRIM_PKGVAR}"

echo ">>> 安装环境初始化完成。"
exit 0
