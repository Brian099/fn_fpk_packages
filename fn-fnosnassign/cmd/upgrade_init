#!/bin/bash

echo ">>> fnosnassign 升级预处理：正在强制释放资源..."

# 1. 尝试优雅停止 (通过 PID)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CMD_MAIN="${APP_ROOT}/cmd/main"
if [ -f "${CMD_MAIN}" ]; then
    bash "${CMD_MAIN}" stop >/dev/null 2>&1
fi

# 2. 暴力清理 (根据二进制名称)
# 无论进程在哪，直接根据名字杀掉，这是最彻底的
pkill -9 fnosnassign_x86_
pkill -9 fnosnassign_aar
pkill -9 fnosnassign

echo ">>> 资源已释放，准备执行升级安装。"
exit 0
