#!/bin/bash

# T3MT视频下载 - 安装回调脚本
# 在安装完成后执行

echo "T3MT安装回调执行中..." >> "${TRIM_TEMP_LOGFILE}"

# 创建必要的数据目录
mkdir -p "${TRIM_PKGVAR}/data"
mkdir -p "${TRIM_PKGVAR}/logs"
mkdir -p "${TRIM_PKGVAR}/downloads"

# 设置目录权限
chmod -R 755 "${TRIM_PKGVAR}"

echo "数据目录创建完成" >> "${TRIM_TEMP_LOGFILE}"
echo "  - 数据目录: ${TRIM_PKGVAR}/data" >> "${TRIM_TEMP_LOGFILE}"
echo "  - 日志目录: ${TRIM_PKGVAR}/logs" >> "${TRIM_TEMP_LOGFILE}"
echo "  - 下载目录: ${TRIM_PKGVAR}/downloads" >> "${TRIM_TEMP_LOGFILE}"

# 拉取Docker镜像（如果不存在）
echo "检查Docker镜像..." >> "${TRIM_TEMP_LOGFILE}"
if ! docker images | grep -q "85423296/t3mt"; then
    echo "正在拉取Docker镜像 85423296/t3mt ..." >> "${TRIM_TEMP_LOGFILE}"
    docker pull 85423296/t3mt >> "${TRIM_TEMP_LOGFILE}" 2>&1
fi

echo "T3MT安装完成" >> "${TRIM_TEMP_LOGFILE}"
exit 0
