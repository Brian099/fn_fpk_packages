#!/bin/bash

# T3MT视频下载 - 卸载回调脚本
# 在卸载完成后执行

echo "T3MT卸载回调执行中..." >> "${TRIM_TEMP_LOGFILE}"

# 获取用户选择的数据处理方式
DATA_ACTION="${wizard_data_action:-keep}"

# 移除Docker容器
if docker ps -a | grep -q "t3mt"; then
    echo "移除T3MT容器..." >> "${TRIM_TEMP_LOGFILE}"
    docker rm -f t3mt >> "${TRIM_TEMP_LOGFILE}" 2>&1
fi

# 根据用户选择处理数据
if [ "$DATA_ACTION" = "delete" ]; then
    echo "删除应用数据..." >> "${TRIM_TEMP_LOGFILE}"
    rm -rf "${TRIM_PKGVAR}/data"
    rm -rf "${TRIM_PKGVAR}/logs"
    rm -rf "${TRIM_PKGVAR}/downloads"
    echo "应用数据已删除" >> "${TRIM_TEMP_LOGFILE}"
else
    echo "保留应用数据" >> "${TRIM_TEMP_LOGFILE}"
    echo "数据位置: ${TRIM_PKGVAR}" >> "${TRIM_TEMP_LOGFILE}"
fi

echo "T3MT卸载完成" >> "${TRIM_TEMP_LOGFILE}"
exit 0
