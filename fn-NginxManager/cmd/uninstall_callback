#!/bin/bash

# cmd/uninstall_callback for NginxManager
# fly-NAS App Uninstallation Logic (Support Keep/Remove)

# 获取向导中选择的清理策略 (默认 keep 为安全起见)
ACTION="${wizard_cleanup_action:-keep}"
# 1. 停止并禁用服务
systemctl stop nginx >/dev/null 2>&1
systemctl disable nginx >/dev/null 2>&1

if [ "$ACTION" = "remove" ]; then
    # 2. 彻底卸载并清理配置
    apt-get purge -y nginx nginx-common nginx-core >/dev/null 2>&1
    
    # 3. 物理清理配置目录
    if [ -d "/etc/nginx" ]; then
        rm -rf /etc/nginx
    fi
    
    # 4. 清理日志目录
    if [ -d "/var/log/nginx" ]; then
        rm -rf /var/log/nginx
    fi
else
    # 2. 仅卸载程序包，保留配置目录
    apt-get remove -y nginx nginx-common nginx-core >/dev/null 2>&1
fi

exit 0
