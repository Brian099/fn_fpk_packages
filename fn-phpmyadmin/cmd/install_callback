#!/bin/bash
# install_callback: 安装后处理
# 负责：生成 phpMyAdmin 配置文件，设置目录权限 (不再执行在线下载，依靠本地离线安装)

set -e

LOG="${TRIM_TEMP_LOGFILE}"
DEST="${TRIM_APPDEST}"
ETC="${TRIM_PKGETC}"
VAR="${TRIM_PKGVAR}"

PHP_DIR="${DEST}/server/php"
PMA_DIR="${DEST}/server/phpmyadmin"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"
}

# 确保必要的目录存在
mkdir -p "${ETC}" "${VAR}" "${VAR}/tmp" "${PHP_DIR}" "${PMA_DIR}"

log "开始配置离线安装的 phpMyAdmin..." | tee -a "${VAR}/install.log"

# 生成 phpMyAdmin 配置文件
CONFIG_FILE="${ETC}/config.inc.php"

if [ ! -f "${CONFIG_FILE}" ]; then
    log "生成 phpMyAdmin 配置文件..." | tee -a "${VAR}/install.log"

    # 生成随机 blowfish_secret（32位随机字符串）
    BLOWFISH=$(cat /dev/urandom | tr -dc 'A-Za-z0-9!@#$%^&*()_+' | head -c 32)

    cat > "${CONFIG_FILE}" <<EOF
<?php
/**
 * phpMyAdmin configuration - Auto generated by fnOS App Center
 * Generated at: $(date '+%Y-%m-%d %H:%M:%S')
 */

\$cfg['blowfish_secret'] = '${BLOWFISH}';

\$i = 0;

/* ---------- Server 1: localhost MariaDB ---------- */
\$i++;
\$cfg['Servers'][\$i]['auth_type']       = 'cookie';
\$cfg['Servers'][\$i]['host']            = '127.0.0.1';
\$cfg['Servers'][\$i]['port']            = '3306';
\$cfg['Servers'][\$i]['connect_type']    = 'tcp';
\$cfg['Servers'][\$i]['compress']        = false;
\$cfg['Servers'][\$i]['AllowNoPassword'] = false;

/* ---------- General settings ---------- */
\$cfg['DefaultLang']           = 'zh_CN';
\$cfg['ServerDefault']         = 1;
\$cfg['UploadDir']             = '';
\$cfg['SaveDir']               = '';
\$cfg['SendErrorReports']      = 'never';
\$cfg['CheckConfigurationPermissions'] = false;

/* Temp directory for phpMyAdmin */
\$cfg['TempDir'] = '${VAR}/tmp';

EOF
    log "配置文件已生成：${CONFIG_FILE}" | tee -a "${VAR}/install.log"
fi

# 将配置文件软链接到 phpMyAdmin 目录
if [ ! -f "${PMA_DIR}/config.inc.php" ]; then
    ln -sf "${CONFIG_FILE}" "${PMA_DIR}/config.inc.php"
fi

# 设置文件权限
chmod -R 755 "${PHP_DIR}"
chmod -R 755 "${PMA_DIR}"
chmod 640 "${CONFIG_FILE}"

# 如果自带了php二进制文件，赋予执行权限
if [ -f "${PHP_DIR}/php" ]; then
    chmod +x "${PHP_DIR}/php"
fi

log "phpMyAdmin 离线部署配置完成！访问端口：${wizard_port}" | tee -a "${VAR}/install.log"
echo "phpMyAdmin 离线包安装成功！" > "${LOG}"

exit 0
