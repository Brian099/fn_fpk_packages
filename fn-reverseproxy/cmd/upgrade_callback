#!/bin/bash

### This script is called after the user upgraded the application.

# Start the service after upgrade
if [ -x "${TRIM_APPDEST:-/var/apps/fn-reverseproxy/target}/main" ]; then
    echo "Starting service after upgrade..."
    "${TRIM_APPDEST:-/var/apps/fn-reverseproxy/target}/main" start
else
    # Try alternative path
    if [ -x "${TRIM_APPDEST:-/var/apps/fn-reverseproxy/target}/cmd/main" ]; then
        echo "Starting service after upgrade..."
        "${TRIM_APPDEST:-/var/apps/fn-reverseproxy/target}/cmd/main" start
    else
        echo "Service control script not found, skipping start"
    fi
fi

exit 0
