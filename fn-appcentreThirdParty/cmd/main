#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

LOG_FILE="${TRIM_PKGVAR:-/var/apps/fn-appcentreThirdParty/var}/info.log"
PID_FILE="${TRIM_PKGVAR:-/var/apps/fn-appcentreThirdParty/var}/app.pid"
SOCKET_FILE="${TRIM_PKGVAR:-/var/apps/fn-appcentreThirdParty/var}/appcentre.sock"
BINARY="${TRIM_APPDEST:-/var/apps/fn-appcentreThirdParty/target}/server/appcentre"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >>"${LOG_FILE}"
}

fail() {
    local msg="$1"
    log_msg "FAIL: ${msg}"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        echo "${msg}" >"${TRIM_TEMP_LOGFILE}"
    fi
    return 1
}

status() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

build_cmd() {
    printf '%s' "APP_APPSTORE_DIR=\"${APP_APPSTORE_DIR:-}\" \"${BINARY}\" --unix-socket \"${SOCKET_FILE}\""
}

start_process() {
    if status; then
        log_msg "Process already running (PID $(head -n 1 "${PID_FILE}"))"
        return 0
    fi

    log_msg "========== STARTING =========="
    log_msg "TRIM_PKGVAR=${TRIM_PKGVAR}"
    log_msg "TRIM_APPDEST=${TRIM_APPDEST}"

    mkdir -p "${TRIM_PKGVAR}"
    mkdir -p "$(dirname "${LOG_FILE}")" 2>/dev/null || true

    if [ ! -f "${BINARY}" ]; then
        fail "Binary not found: ${BINARY}"
        log_msg "Contents of ${TRIM_APPDEST}:
"
        ls -la "${TRIM_APPDEST}" >>"${LOG_FILE}" 2>&1 || true
        return 1
    fi

    chmod +x "${BINARY}"

    local cmd
    cmd="$(build_cmd)"
    log_msg "Exec: ${cmd}"

    bash -c "${cmd}" >>"${LOG_FILE}" 2>&1 &
    local pid=$!
    printf "%s" "$pid" >"${PID_FILE}"

    sleep 2
    if status; then
        log_msg "Process started successfully (PID ${pid})"
        log_msg "Unix socket: ${SOCKET_FILE}"
    else
        log_msg "Process failed to start or exited immediately"
        fail "应用启动失败，请查看日志: ${LOG_FILE}"
        return 1
    fi
    return 0
}

stop_process() {
    log_msg "========== STOPPING =========="

    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            log_msg "Sending SIGTERM to PID ${pid}"
            kill "${pid}" 2>/dev/null
            local wait_count=0
            while kill -0 "${pid}" 2>/dev/null && [ $wait_count -lt 10 ]; do
                sleep 1
                wait_count=$((wait_count + 1))
            done
            if kill -0 "${pid}" 2>/dev/null; then
                log_msg "SIGTERM timeout, sending SIGKILL to PID ${pid}"
                kill -9 "${pid}" 2>/dev/null
            fi
            log_msg "Process terminated"
        else
            log_msg "PID file exists but process not running"
        fi
        rm -f "${PID_FILE}"
    else
        log_msg "No PID file found"
    fi

    rm -f "${SOCKET_FILE}"
    log_msg "Cleanup complete"
    return 0
}

reload_process() {
    log_msg "========== RELOADING =========="
    stop_process
    sleep 1
    start_process
}

case "$1" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
restart)
    stop_process
    sleep 1
    start_process
    ;;
reload)
    reload_process
    ;;
status)
    if status; then
        echo "Running (PID $(head -n 1 "${PID_FILE}"))"
        exit 0
    else
        echo "Not running"
        exit 3
    fi
    ;;
*)
    echo "Usage: $0 {start|stop|restart|reload|status}"
    exit 1
    ;;
esac

exit 0
