[
    {
        "stepTitle": "MariaDB 12 配置",
        "items": [
            {
                "type": "tips",
                "helpText": "请设置 MariaDB 12 的运行端口和 Root 管理员密码。建议使用 8 位以上强密码。"
            },
            {
                "type": "text",
                "field": "service_port",
                "label": "数据库端口",
                "initValue": "3306",
                "rules": [
                    { "required": true, "message": "端口号不能为空" },
                    { "pattern": "^[0-9]+$", "message": "端口号必须是数字" },
                    { "min": 1, "max": 65535, "message": "无效的端口号范围" }
                ]
            },
            {
                "type": "password",
                "field": "service_password",
                "label": "Root 管理员密码",
                "initValue": "",
                "rules": [
                    { "required": true, "message": "Root 密码不能为空" },
                    { "min": 1, "max": 64, "message": "密码长度在 1-64 位之间" }
                ]
            }
        ]
    }
]
