#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TRIM_PKGVAR="${TRIM_PKGVAR:-${APP_ROOT}/var}"
CONF_FILE="${TRIM_PKGVAR}/config.json"

echo ">>> ImagesGallery 安装回调开始..."

# 1. 确保必要的目录存在
mkdir -p "${TRIM_PKGVAR}"
mkdir -p "${TRIM_PKGVAR}/uploads"

# 2. 初始化默认配置 (如果不存在)
if [ ! -f "${CONF_FILE}" ]; then
    echo "正在初始化默认配置文件..."
    cat > "${CONF_FILE}" <<EOF
{
    "host": "0.0.0.0",
    "port": "23721",
    "external_enabled": true,
    "debug": false
}
EOF
fi

# 3. 权限修正
# 确保运行用户对数据目录有完全控制权
chmod -R 755 "${TRIM_PKGVAR}"

echo ">>> 安装环境初始化完成。"
exit 0
