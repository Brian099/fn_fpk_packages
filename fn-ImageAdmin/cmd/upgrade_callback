#!/bin/bash

echo ">>> ImagesGallery 升级回调开始..."

# 升级时通常只需确保权限
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TRIM_APPDEST="${TRIM_APPDEST:-${APP_ROOT}/app}"

# 给新版本的二进制文件加执行权限
chmod +x "${TRIM_APPDEST}/server/amd64/imageadmin_x86_64" 2>/dev/null
chmod +x "${TRIM_APPDEST}/server/arm64/imageadmin_aarch64" 2>/dev/null

# 重启服务以应用新版本
if [ -f "${SCRIPT_DIR}/main" ]; then
    echo ">>> 正在重启服务以应用新版本..."
    bash "${SCRIPT_DIR}/main" restart
fi

echo ">>> ImagesGallery 升级完成。"
exit 0
