#!/bin/bash

echo "便签应用更新回调..."

# Start the service after upgrade
if [ -x "${TRIM_APPDEST:-/var/apps/notepad/target}/main" ]; then
    echo "Starting service after upgrade..."
    "${TRIM_APPDEST:-/var/apps/notepad/target}/main" start
else
    # Try alternative path
    if [ -x "${TRIM_APPDEST:-/var/apps/notepad/target}/cmd/main" ]; then
        echo "Starting service after upgrade..."
        "${TRIM_APPDEST:-/var/apps/notepad/target}/cmd/main" start
    else
        echo "Service control script not found, skipping start"
    fi
fi

exit 0
