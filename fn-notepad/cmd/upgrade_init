#!/bin/bash

echo "便签应用更新初始化..."

# Stop the service before upgrade
if [ -x "${TRIM_APPDEST:-/var/apps/notepad/target}/main" ]; then
    echo "Stopping service before upgrade..."
    "${TRIM_APPDEST:-/var/apps/notepad/target}/main" stop
else
    # Try alternative path
    if [ -x "${TRIM_APPDEST:-/var/apps/notepad/target}/cmd/main" ]; then
        echo "Stopping service before upgrade..."
        "${TRIM_APPDEST:-/var/apps/notepad/target}/cmd/main" stop
    else
        echo "Service control script not found, skipping stop"
    fi
fi

exit 0
